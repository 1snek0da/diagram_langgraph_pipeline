# Offline by default. Set to 1 only when network-backed sources are intended.
ENABLE_NETWORK_RESEARCH=0
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_MIN_INTERVAL_SECONDS=0.1

# SEC requires an identifying application name and contact email.
SEC_USER_AGENT=

# Optional licensed/authorized sources.
TUSHARE_TOKEN=
LICENSED_REPORT_DIRS=
CNINFO_BASE_URL=
CNINFO_DATASET_PATHS=
CNINFO_TOKEN=

# Optional local vendor SDK registration.
ENABLE_WIND=0
ENABLE_IFIND=0

# Optional PostgreSQL persistence. Keep the real value in .env.local or the process environment.
DATABASE_URL=
YFINANCE_CACHE_DIR=.local/yfinance-cache

# Web runtime: start the API and Streamlit in separate terminals.
DLP_API_BASE_URL=http://127.0.0.1:8000
DLP_API_MAX_WORKERS=1
DLP_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
DLP_FRONTEND_DIST=

# Optional OpenAI-compatible LLM advisory through Volcengine Ark or a relay.
# Keep ENABLE_LLM_ADVISORY=0 until the endpoint, model identifier, and key are verified.
ENABLE_LLM_ADVISORY=0
VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_API_KEY=
VOLCENGINE_LLM_MODEL=deepseek-v4-flash
VOLCENGINE_LLM_TIMEOUT_SECONDS=120
VOLCENGINE_LLM_MAX_TOKENS=1200
VOLCENGINE_LLM_TEMPERATURE=0.1
VOLCENGINE_LLM_DISABLE_THINKING=0
VOLCENGINE_LLM_JSON_MODE=0

# Named enhanced profile defaults (state values may override these per run).
RUN_PROFILE=d4f_70d
DAILY_TRADING_DAYS=70
TECHNICAL_TRADING_DAYS=251
TECHNICAL_HISTORY_DAYS=550
INTRADAY_INTERVAL=60m
INTRADAY_TARGET_BARS_PER_DAY=15
NEWS_LIMIT=36
LLM_PROMPT_TOKEN_LIMIT=128000
LLM_PROJECTION_TARGET=115000
LLM_MAX_CONCURRENCY=3
